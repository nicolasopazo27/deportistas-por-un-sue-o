<collaboration id="collab_proc_asis">
<participant id="participant_proc_asis" name="Fundación Deportistas por un Sueño - Proceso actual (AS-IS)" processRef="proc_asis" />
</collaboration>

<process id="proc_asis" name="AS-IS - Registro y seguimiento de atención de beneficiarios" isExecutable="false">
<laneSet id="laneSet_1"><lane id="lane_comuna" name="Encargada de comuna"><flowNodeRef>start1</flowNodeRef><flowNodeRef>task1</flowNodeRef><flowNodeRef>task2</flowNodeRef></lane><lane id="lane_social" name="Trabajadora social"><flowNodeRef>task3</flowNodeRef><flowNodeRef>gw1</flowNodeRef><flowNodeRef>task9</flowNodeRef><flowNodeRef>gw4</flowNodeRef><flowNodeRef>task10</flowNodeRef><flowNodeRef>end1</flowNodeRef><flowNodeRef>interEvent1</flowNodeRef><flowNodeRef>task11</flowNodeRef><flowNodeRef>task12</flowNodeRef><flowNodeRef>end2</flowNodeRef></lane><lane id="lane_tens" name="TENS"><flowNodeRef>task4</flowNodeRef><flowNodeRef>task8</flowNodeRef><flowNodeRef>gw3</flowNodeRef></lane><lane id="lane_prof" name="Profesional dental/kine"><flowNodeRef>task5</flowNodeRef><flowNodeRef>gw2</flowNodeRef><flowNodeRef>task6</flowNodeRef><flowNodeRef>task7</flowNodeRef></lane></laneSet>
<startEvent id="start1" name="Necesidad de atención detectada" /><task id="task1" name="Realizar llamado telefónico semanal a la familia" /><task id="task2" name="Comunicar derivación (WhatsApp)" /><task id="task3" name="Registrar derivación en Excel Drive" /><exclusiveGateway id="gw1" name="¿Ingreso o Reingreso?" /><task id="task4" name="Coordinar y agendar atención" /><task id="task5" name="Ejecutar atención dental/kine" /><exclusiveGateway id="gw2" name="¿Atención realizada?" /><task id="task6" name="Registrar motivo de no atención" /><task id="task7" name="Registrar detalle clínico en Dental Soft" /><task id="task8" name="Actualizar sesión y estado del ciclo" /><exclusiveGateway id="gw3" name="¿Ciclo terminado?" /><task id="task9" name="Revisar Excel y detectar duplicados" /><exclusiveGateway id="gw4" name="¿Caso duplicado?" /><task id="task10" name="Informar duplicado a TENS" /><endEvent id="end1" name="Ciclo de atención cerrado" /><intermediateCatchEvent id="interEvent1" name="Se recibe aviso de baja del caso" /><task id="task11" name="Registrar desvinculación/egreso/fallecimiento" /><task id="task12" name="Reportar al Ministerio" /><endEvent id="end2" name="Caso cerrado por baja" />
<sequenceFlow id="flow_1" sourceRef="start1" targetRef="task1" /><sequenceFlow id="flow_2" sourceRef="task1" targetRef="task2" /><sequenceFlow id="flow_3" sourceRef="task2" targetRef="task3" /><sequenceFlow id="flow_4" sourceRef="task3" targetRef="gw1" /><sequenceFlow id="flow_5" sourceRef="gw1" targetRef="task4" name="Ingreso" /><sequenceFlow id="flow_6" sourceRef="gw1" targetRef="task4" name="Reingreso" /><sequenceFlow id="flow_7" sourceRef="task4" targetRef="task5" /><sequenceFlow id="flow_8" sourceRef="task5" targetRef="gw2" /><sequenceFlow id="flow_9" sourceRef="gw2" targetRef="task6" name="No" /><sequenceFlow id="flow_10" sourceRef="task6" targetRef="task4" name="Reagendar" /><sequenceFlow id="flow_11" sourceRef="gw2" targetRef="task7" name="Sí" /><sequenceFlow id="flow_12" sourceRef="task7" targetRef="task8" /><sequenceFlow id="flow_13" sourceRef="task8" targetRef="gw3" /><sequenceFlow id="flow_14" sourceRef="gw3" targetRef="task4" name="No (nueva sesión)" /><sequenceFlow id="flow_15" sourceRef="gw3" targetRef="task9" name="Sí" /><sequenceFlow id="flow_16" sourceRef="task9" targetRef="gw4" /><sequenceFlow id="flow_17" sourceRef="gw4" targetRef="task10" name="Sí" /><sequenceFlow id="flow_18" sourceRef="task10" targetRef="end1" /><sequenceFlow id="flow_19" sourceRef="gw4" targetRef="end1" name="No" /><sequenceFlow id="flow_20" sourceRef="task3" targetRef="interEvent1" /><sequenceFlow id="flow_21" sourceRef="interEvent1" targetRef="task11" /><sequenceFlow id="flow_22" sourceRef="task11" targetRef="task12" /><sequenceFlow id="flow_23" sourceRef="task12" targetRef="end2" />
</process>

