<process id="proc_tobe" name="TO-BE - Registro y seguimiento de atención de beneficiarios" isExecutable="false">
<laneSet id="laneSet_1"><lane id="lane_comuna" name="Encargada de comuna"><flowNodeRef>start1</flowNodeRef><flowNodeRef>task1</flowNodeRef><flowNodeRef>task2</flowNodeRef></lane><lane id="lane_social" name="Trabajadora social"><flowNodeRef>start2</flowNodeRef><flowNodeRef>taskAlt</flowNodeRef><flowNodeRef>interEvent1</flowNodeRef><flowNodeRef>task13</flowNodeRef></lane><lane id="lane_tens" name="TENS"><flowNodeRef>task6</flowNodeRef><flowNodeRef>task7</flowNodeRef></lane><lane id="lane_prof" name="Profesional dental/kine"><flowNodeRef>task8</flowNodeRef><flowNodeRef>gw2</flowNodeRef><flowNodeRef>task9</flowNodeRef><flowNodeRef>task10</flowNodeRef></lane><lane id="lane_sistema" name="Sistema"><flowNodeRef>task3</flowNodeRef><flowNodeRef>gw1</flowNodeRef><flowNodeRef>task4</flowNodeRef><flowNodeRef>task5</flowNodeRef><flowNodeRef>task11</flowNodeRef><flowNodeRef>task12</flowNodeRef><flowNodeRef>gw3</flowNodeRef><flowNodeRef>end1</flowNodeRef><flowNodeRef>task14</flowNodeRef><flowNodeRef>end2</flowNodeRef><flowNodeRef>task15</flowNodeRef></lane></laneSet>
<startEvent id="start1" name="Necesidad de atención detectada" /><task id="task1" name="Realizar llamado telefónico semanal a la familia" /><task id="task2" name="Registrar derivación directo en el sistema" /><startEvent id="start2" name="Apoderado solicita atención directamente" /><task id="taskAlt" name="Registrar solicitud en el sistema" /><task id="task3" name="Validar automáticamente si el beneficiario ya tiene un caso activo" /><exclusiveGateway id="gw1" name="¿Caso duplicado detectado?" /><task id="task4" name="Notificar duplicado a Trabajadora social/TENS" /><task id="task5" name="Consolidar ficha única del beneficiario" /><task id="task6" name="Coordinar y agendar atención" /><task id="task7" name="Registrar agendamiento en el sistema" /><task id="task8" name="Ejecutar atención dental/kine" /><exclusiveGateway id="gw2" name="¿Atención realizada?" /><task id="task9" name="Registrar motivo de no atención en el sistema" /><task id="task10" name="Registrar atención realizada en el sistema" /><task id="task11" name="Actualizar automáticamente estado del ciclo y contador de sesiones" /><task id="task12" name="Generar alerta si el caso lleva tiempo sin actualización" /><exclusiveGateway id="gw3" name="¿Ciclo terminado?" /><endEvent id="end1" name="Ciclo de atención cerrado" /><intermediateCatchEvent id="interEvent1" name="Se recibe aviso de baja del caso" /><task id="task13" name="Registrar baja vinculada a la ficha del beneficiario" /><task id="task14" name="Generar automáticamente reporte de baja para el Ministerio" /><endEvent id="end2" name="Caso cerrado por baja" /><task id="task15" name="Generar automáticamente informe de gestión mensual consolidado" />
<sequenceFlow id="flow_1" sourceRef="start1" targetRef="task1" /><sequenceFlow id="flow_2" sourceRef="task1" targetRef="task2" /><sequenceFlow id="flow_3" sourceRef="task2" targetRef="task3" /><sequenceFlow id="flow_4" sourceRef="start2" targetRef="taskAlt" /><sequenceFlow id="flow_5" sourceRef="taskAlt" targetRef="task3" /><sequenceFlow id="flow_6" sourceRef="task3" targetRef="gw1" /><sequenceFlow id="flow_7" sourceRef="gw1" targetRef="task4" name="Sí" /><sequenceFlow id="flow_8" sourceRef="task4" targetRef="task5" /><sequenceFlow id="flow_9" sourceRef="gw1" targetRef="task5" name="No" /><sequenceFlow id="flow_10" sourceRef="task5" targetRef="task6" /><sequenceFlow id="flow_11" sourceRef="task6" targetRef="task7" /><sequenceFlow id="flow_12" sourceRef="task7" targetRef="task8" /><sequenceFlow id="flow_13" sourceRef="task8" targetRef="gw2" /><sequenceFlow id="flow_14" sourceRef="gw2" targetRef="task9" name="No" /><sequenceFlow id="flow_15" sourceRef="task9" targetRef="task6" name="Reagendar" /><sequenceFlow id="flow_16" sourceRef="gw2" targetRef="task10" name="Sí" /><sequenceFlow id="flow_17" sourceRef="task10" targetRef="task11" /><sequenceFlow id="flow_18" sourceRef="task11" targetRef="task12" /><sequenceFlow id="flow_19" sourceRef="task12" targetRef="gw3" /><sequenceFlow id="flow_20" sourceRef="gw3" targetRef="task6" name="No (nueva sesión)" /><sequenceFlow id="flow_21" sourceRef="gw3" targetRef="end1" name="Sí" /><sequenceFlow id="flow_22" sourceRef="interEvent1" targetRef="task13" /><sequenceFlow id="flow_23" sourceRef="task13" targetRef="task14" /><sequenceFlow id="flow_24" sourceRef="task14" targetRef="end2" />
</process>

